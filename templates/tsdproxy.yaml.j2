{#
  TSDProxy (v2 and later) reads this file strictly: keys are case-sensitive,
  and an unknown key - such as the all-lowercase keys of TSDProxy v1 - makes
  it refuse to start. Values are rendered with `to_json` (which is valid YAML)
  so that they cannot break the document.

  cf. https://almeidapaulopt.github.io/tsdproxy/docs/serverconfig/
#}
defaultProxyProvider: default
docker:
  local:
    host: {{ tsdproxy_docker_endpoint | to_json }}
    targetHostname: {{ tsdproxy_docker_target_hostname | to_json }}
    tryDockerInternalNetwork: {{ tsdproxy_docker_try_internal_network | bool | to_json }}
    defaultProxyProvider: default
lists: {{ tsdproxy_config_lists | to_json }}
tailscale:
  providers:
    default:
      authKey: {{ tsdproxy_config_tailscale_providers_default_authkey | to_json }}
      authKeyFile: {{ tsdproxy_config_tailscale_providers_default_authkeyfile | to_json }}
      clientId: {{ tsdproxy_config_tailscale_providers_default_clientid | to_json }}
      clientSecret: {{ tsdproxy_config_tailscale_providers_default_clientsecret | to_json }}
      tags: {{ tsdproxy_config_tailscale_providers_default_tags | to_json }}
      controlUrl: {{ tsdproxy_config_tailscale_providers_default_controlurl | to_json }}

    {{ tsdproxy_config_tailscale_providers_additional_providers | indent(4) }}
  dataDir: /data/
http:
  hostname: 0.0.0.0
  port: {{ tsdproxy_container_http_port | int }}
log:
  level: {{ tsdproxy_config_log_level | to_json }}
  json: false
proxyAccessLog: {{ tsdproxy_config_proxyaccesslog | bool | to_json }}
